# ==============================================================================
#  .nimorc - Nimo Editor Configuration
#  Written in Pure x86_64 Assembly without LibC
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cursor Appearance
# ------------------------------------------------------------------------------
# BlinkingCursor: Set to true for a blinking terminal block cursor (\033[1 q),
# or false for a steady non-blinking block cursor (\033[2 q).
# Runtime hotkey toggle: Ctrl+B or Alt+B
BlinkingCursor = true

# ------------------------------------------------------------------------------
# 2. Line Numbers & Dynamic Typing Display
# ------------------------------------------------------------------------------
# LineNumbers: Master toggle to show or hide line numbers in the gutter.
# Runtime hotkey toggle: Ctrl+N or Alt+N
LineNumbers = true

# LineNumbersTypeOnly: When true, line numbers only appear on lines as you type
# or on the active cursor line (blank lines below content have no numbers).
LineNumbersTypeOnly = true

# ------------------------------------------------------------------------------
# 3. Gutter Separator & Styles
# ------------------------------------------------------------------------------
# Separator: Master toggle for the vertical gutter divider.
# Runtime hotkey toggle: Ctrl+S or Alt+S
Separator = true

# SeparatorStyle: Style of the vertical gutter boundary.
# Available options:
#   - pipe    : Modern clean Unicode box bar " │ "
#   - thin    : Classic ASCII pipe " | "
#   - double  : Bold double-line Unicode bar " ║ "
#   - dots    : Elegant dotted dashed divider " ┆ "
#   - slash   : Stylized programmer slash " // "
#   - none    : Invisible 3-space margin "   "
# Runtime hotkey cycle: Ctrl+P or Alt+P
SeparatorStyle = pipe
# CustomSeperator = '{line} :'

# CustomSeparator: Custom format string for the line number and separator.
# Use '{line}' as the placeholder for the line number.
# Leave empty or commented out to use standard LineNumbers + SeparatorStyle.
# Examples:
#   CustomSeparator = '{line} :'   -> produces "  1 : "
#   CustomSeparator = '{line} ]'   -> produces "  1 ] "
#   CustomSeparator = '{line} |'   -> produces "  1 | "
#   CustomSeparator = ''           -> default style
# CustomSeparator = '{line} :'

# ------------------------------------------------------------------------------
# 4. Interface Bars (Disableable and Re-enablable)
# ------------------------------------------------------------------------------
# TopBar: Show or hide top Catppuccin Mauve header with filename and [*Modified] pill.
TopBar = true

# StatusBar: Show or hide bottom status bar with line/column and byte counts.
StatusBar = true

# Footer: Show or hide the bottom two Nano shortcut helper rows (^O, ^X, ^K, etc.).
Footer = true

# ------------------------------------------------------------------------------
# 5. Active Cursor Line Highlight & Glow (nanorc & nimorc compatible)
# ------------------------------------------------------------------------------
# Highlight: Enable/disable faint editing glow on cursor row (nanorc: set/unset spotlight)
Highlight = true

# HighlightColor: Color of the active line glow (nanorc: set stripecolor <color>)
# Supports Catppuccin names (mauve, blue, peach, green, yellow, teal, red, lavender,
# sapphire, surface) or hex (#cba6f7) or rgb(r, g, b).
HighlightColor = mauve

# HighlightOpacity: Opacity of the faint glow blended over background
# Supports float (0.0 to 1.0) or percentage (e.g. 10%, 15%, 25%)
HighlightOpacity = 0.08

# ------------------------------------------------------------------------------
# 6. Auto-Completions & Auto-Pairing (Code Files)
# ------------------------------------------------------------------------------
# AutoCompletions: Automatically insert matching pairs (), [], {}, "", '', ``
# with cursor placed in between, smart skip-over on closing characters,
# smart backspace deletion of empty pairs, and block indentation on Enter.
# Automatically disabled by default on .txt and non-code plain text files.
# Runtime hotkey toggle: Ctrl+Shift+A or Alt+A
# nanorc syntax: set autocompletions / unset autocompletions
AutoCompletions = true

# ------------------------------------------------------------------------------
# 7. Bottom Helper Commands & Compact Footer (Android & Desktop Adaptive)
# ------------------------------------------------------------------------------
# CompactFooter: Controls shortcut helper command rows at the bottom of the screen.
#   - auto   : Automatically uses 1 compact row on mobile / Android Termux screens
#              (height <= 18) or when virtual keyboard is active, and 2 rows on
#              desktop / larger terminals (height > 18).
#   - true   : Always use 1 compact row (nano minibar style, saving vertical space).
#   - false  : Always use 2 full rows.
# nanorc syntax: set minibar (compact) / unset minibar (2 rows)
CompactFooter = auto

# ------------------------------------------------------------------------------
# 8. Line Wrapping / Soft Wrap (WarpLine)
# ------------------------------------------------------------------------------
# WarpLine: When true, long lines that extend beyond the screen width are wrapped
# onto the next visual line with an indicator arrow (|_>).
# Runtime hotkey toggle: Alt+L or Alt+Z
# nanorc syntax: set softwrap / unset softwrap
WarpLine = true



